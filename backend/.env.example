# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (สำหรับรันบนเครื่อง local)
# บน Render.com ให้ตั้งค่าตัวแปรเหล่านี้ใน Environment ของ Web Service แทน

# Connection string จาก Neon (Settings > Connection Details)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# ใช้สำหรับเซ็นและตรวจสอบ JWT token - ตั้งเป็นข้อความสุ่มที่คาดเดายาก
JWT_SECRET=change-this-to-a-long-random-secret

# โดเมนของ frontend ที่อนุญาตให้เรียก API (คั่นด้วยจุลภาคได้หลายค่า) หรือใส่ * เพื่ออนุญาตทั้งหมด
CORS_ORIGIN=*

# พอร์ตที่ backend รัน (Render จะกำหนดให้อัตโนมัติผ่าน PORT)
PORT=4000

# ใช้ตอนรัน npm run seed-admin เพื่อสร้างบัญชีผู้ดูแลระบบ
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
